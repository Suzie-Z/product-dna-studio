# Server only. Never commit real values. The server reads the process environment,
# not this example file. Configure actual values on Render's Environment page.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
DAILY_GENERATION_LIMIT=10
# Optional comma-separated frontend origins, for a custom frontend domain.
ALLOWED_ORIGINS=
# Optional public trial launch date, YYYY-MM-DD in Australia/Sydney. Seven days.
TRIAL_START_DATE=
PORT=10000
