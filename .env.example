# Server only. Never commit real values. The server reads the process environment,
# not this example file. Configure actual values on Render's Environment page.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Career Studio V2: explicit stage choices, no automatic model failover.
OPENAI_CAREER_MODEL=gpt-6-astra
OPENAI_SUMMARY_MODEL=gpt-6-astra
OPENAI_REFINEMENT_MODEL=gpt-6-astra
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
DAILY_GENERATION_LIMIT=10
# Optional comma-separated frontend origins, for a custom frontend domain.
ALLOWED_ORIGINS=
# Optional public trial launch date, YYYY-MM-DD in Australia/Sydney. Seven days.
TRIAL_START_DATE=
PORT=10000

# Optional private PostgreSQL URL. Omit for explicitly labelled per-process counts.
COUNTER_DATABASE_URL=
